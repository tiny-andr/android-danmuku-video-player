#!/usr/bin/env node
// Tauri 的 Android Gradle 插件会在 src-tauri 目录执行 `node tauri android android-studio-script`。
// 这里转发到项目本地安装的 @tauri-apps/cli，保证构建不依赖全局 PATH 或别的工程。
const { spawnSync } = require("child_process");
const path = require("path");

const cli = path.join(__dirname, "..", "node_modules", "@tauri-apps", "cli", "tauri.js");
const result = spawnSync(process.execPath, [cli].concat(process.argv.slice(2)), {
  stdio: "inherit",
});
process.exit(result.status == null ? 1 : result.status);
